# Loop through each line of the file
# IFS: Internal Field Separator
lineCount=0
while IFS= read -r line || [[ -n "$line" ]]; do
  # Place your commands here to process the current line
  ((lineCounter++))
  c=$( wc -c "$line"|awk '{print $1}' )
  w=$( wc -w "$line"|awk '{print $1}' )
  l=$( wc -l "$line"|awk '{print $1}' )
  echo "Processing line $lineCounter: $line has $c characters, $w words and $l lines "
done < filename


